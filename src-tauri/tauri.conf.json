{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimcut",
  "version": "0.2.6",
  "identifier": "com.grimmers.grimcut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grimcut",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset: https://asset.localhost http://asset.localhost http://tauri.localhost https://tauri.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: https://asset.localhost http://asset.localhost blob: data:",
        "media-src": "'self' asset: https://asset.localhost http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRDExRTZEODdGRDZCQ0IKUldUTGEvMkhiUjdSZW9LQWFZenlIYjhZU3JveWNXNGtGbnBUV3FqZmk0bENhV1RsRjY0Y09kQk8K",
      "endpoints": ["https://github.com/Grimstuff/grimcut/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../scripts/install-ffmpeg.ps1": "install-ffmpeg.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
